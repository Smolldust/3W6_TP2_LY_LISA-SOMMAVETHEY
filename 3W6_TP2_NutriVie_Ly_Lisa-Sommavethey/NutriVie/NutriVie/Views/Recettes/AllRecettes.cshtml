@model List<NutriVie.ViewModels.RecetteCetegorieVM>

@{
    ViewData["Title"] = "Recettes";
}

<h1>Recettes</h1>

<div class="accordion" id="accordionRecettes">
    @foreach (var categorie in Model)
    {
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-@categorie.CategorieId">
                    @categorie.NomCategorie
                </button>
            </h2>
            <div id="collapse-@categorie.CategorieId"
                 class="accordion-collapse collapse"
                 data-bs-parent="#accordionRecettes">
                <div class="accordion-body">
                    <partial name="RecetteCategorie" model="categorie" />
                </div>
            </div>
        </div>
    }
</div>