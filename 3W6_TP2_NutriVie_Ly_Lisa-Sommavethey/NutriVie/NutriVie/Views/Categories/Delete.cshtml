@model NutriVie.Models.Categorie

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Categorie</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nom)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nom)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        @if (ViewData["MessageErreur"] != null)
            {
                <p class="text-warning">@ViewData["MessageErreur"]</p>
            }
            <partial name="_BoutonsDelete"/>
    </form>
</div>
