@model NutriVie.ViewModels.StatVM
@{
    ViewData["Title"] = "Stats";
}

<h1>Stats</h1>

<p>Le nombre de recette avec 3 aliments : <strong>@Model.NbRecettesTroisAliments</strong></p>

<p>L'aliment le plus calorique : <strong>@Model.AlimentPlusCalorique</strong></p>

<h4>La liste des 4 recettes qui ont le plus court temps total (préparation et cuisson) en affichant le nom et le temps total</h4>

<table class="table" style="width: 400px;">
    <thead>
        <tr>
            <th>Nom de la recette</th>
            <th>Temps total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var recette in Model.RecettesCourtes)
        {
            <tr>
                <td>@recette.Nom</td>
                <td>@(recette.TempsPreparation + recette.TempsCuisson)</td>
            </tr>
        }

    </tbody>
</table>

<p>Le nombre de calories de la recette française la moins calorique : <strong>@Model.NbCalorieFaibleRecetteFrancais.ToString("F2")</strong></p>